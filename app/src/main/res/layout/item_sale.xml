<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Date/time -->
    <TextView
        android:id="@+id/tvSaleDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2025-11-22 14:35"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvSaleTotal"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp"/>

    <!-- Total on the right -->
    <TextView
        android:id="@+id/tvSaleTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$18.99"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Receipt-style summary (first few lines) -->
    <TextView
        android:id="@+id/tvSaleReceiptPreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Items:\n2x Coke @ $1.50 = $3.00\n1x Chips @ $2.00 = $2.00"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tvSaleDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>