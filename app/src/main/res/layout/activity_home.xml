<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- App title -->
    <TextView
        android:id="@+id/tvHomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TinySale"
        android:textSize="53sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Products button -->
    <Button
        android:id="@+id/btnProducts"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:text="Products"
        android:onClick="onProductsClicked"
        app:layout_constraintTop_toBottomOf="@id/tvHomeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <!-- New Sale button -->
    <Button
        android:id="@+id/btnNewSale"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:text="New Sale"
        android:onClick="onNewSaleClicked"
        app:layout_constraintTop_toBottomOf="@id/btnProducts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Sales History button -->
    <Button
        android:id="@+id/btnSalesHistory"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:text="Sales History"
        android:onClick="onSalesHistoryClicked"
        app:layout_constraintTop_toBottomOf="@id/btnNewSale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>