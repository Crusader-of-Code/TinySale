<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Screen title -->
    <TextView
        android:id="@+id/tvNewSaleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Sale"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="9dp"/>

    <!-- Scan / Select product button -->
    <Button
        android:id="@+id/btnSelectProduct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select Product"
        app:layout_constraintTop_toBottomOf="@id/tvNewSaleTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <EditText
        android:id="@+id/etSku"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Scan or type SKU"
        android:inputType="text"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnSelectProduct"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Selected product info -->
    <TextView
        android:id="@+id/tvSelectedProduct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="No product selected"
        android:textAlignment="center"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSelectProduct" />

    <!-- Quantity -->
    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Quantity"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedProduct"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAddItem"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"/>

    <!-- Add item to cart -->
    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Item"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedProduct"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Cart items list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCartItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etQuantity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/etDiscountPercent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- Discount percent -->
    <EditText
        android:id="@+id/etDiscountPercent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Discount %"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/rvCartItems"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tax rate -->
    <EditText
        android:id="@+id/etTaxRate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Tax %"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/etDiscountPercent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Payment method -->
    <Spinner
        android:id="@+id/spinnerPaymentMethod"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/etTaxRate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Customer email (optional) -->
    <EditText
        android:id="@+id/etCustomerEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Customer email (optional)"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/spinnerPaymentMethod"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Subtotal -->
    <TextView
        android:id="@+id/tvSubtotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Subtotal: $0.00"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/etCustomerEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Final total -->
    <TextView
        android:id="@+id/tvFinalTotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="Total: $0.00"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnCompleteSale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtotal" />

    <!-- Complete sale button at bottom -->
    <Button
        android:id="@+id/btnCompleteSale"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Complete Sale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>